diff --git a/zerofs/src/diag.rs b/zerofs/src/diag.rs
new file mode 100644
index 00000000..bbeb7e4e
--- /dev/null
+++ b/zerofs/src/diag.rs
@@ -0,0 +1,138 @@
+//! Diagnostic-only stage timers and CPU sampler for the sustained-drain study.
+//! Enabled by ZEROFS_DIAG_DIR. Not part of the product build.
+use std::future::Future;
+use std::io::Write;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+pub const WB_RAM_ADMISSION: usize = 0;
+pub const WB_SSD_ADMISSION: usize = 1;
+pub const WB_MULTIPART_RAM: usize = 2;
+pub const REMOTE_VERIFY_OPEN: usize = 3;
+pub const REMOTE_READ_COLLECT: usize = 4;
+pub const REMOTE_POOL_PUT: usize = 5;
+pub const REMOTE_COMMIT_RUN: usize = 6;
+pub const POOL_HASH: usize = 7;
+pub const POOL_CATALOG: usize = 8;
+pub const POOL_MEMBER_PUT: usize = 9;
+pub const POOL_ENSURE_MEMBER: usize = 10;
+pub const LOCAL_LOCK_PARENTS: usize = 11;
+pub const LOCAL_INNER_PUT: usize = 12;
+pub const JOURNAL_STAGE: usize = 13;
+pub const JOURNAL_COMMIT: usize = 14;
+pub const EXTENT_SEAL_OPEN: usize = 15;
+pub const REMOTE_APPLY: usize = 16;
+pub const POOL_HEAD: usize = 17;
+const NAMES: [&str; 18] = [
+    "wb.ram_admission",
+    "wb.ssd_admission",
+    "wb.multipart_ram_admission",
+    "remote.verify_open",
+    "remote.read_collect",
+    "remote.pool_put",
+    "remote.commit_run",
+    "pool.hash",
+    "pool.catalog",
+    "pool.member_put",
+    "pool.ensure_member",
+    "local.lock_parents",
+    "local.inner_put",
+    "journal.stage_batch",
+    "journal.commit_staged",
+    "extent.seal_open",
+    "remote.apply_record",
+    "pool.head",
+];
+static NS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+static COUNT: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+
+pub fn record(stage: usize, started: Instant) {
+    NS[stage].fetch_add(started.elapsed().as_nanos() as u64, Ordering::Relaxed);
+    COUNT[stage].fetch_add(1, Ordering::Relaxed);
+}
+
+pub async fn time<F: Future>(stage: usize, future: F) -> F::Output {
+    let started = Instant::now();
+    let output = future.await;
+    record(stage, started);
+    output
+}
+
+pub fn time_sync<T>(stage: usize, operation: impl FnOnce() -> T) -> T {
+    let started = Instant::now();
+    let output = operation();
+    record(stage, started);
+    output
+}
+
+fn snapshot(origin: Instant) -> String {
+    let mut line = format!("{{\"t\":{:.3}", origin.elapsed().as_secs_f64());
+    for (index, name) in NAMES.iter().enumerate() {
+        line.push_str(&format!(
+            ",\"{name}\":[{},{}]",
+            COUNT[index].load(Ordering::Relaxed),
+            NS[index].load(Ordering::Relaxed)
+        ));
+    }
+    line.push('}');
+    line
+}
+
+pub fn start() {
+    let Some(dir) = std::env::var_os("ZEROFS_DIAG_DIR") else {
+        return;
+    };
+    let dir = std::path::PathBuf::from(dir);
+    let origin = Instant::now();
+    let stages = dir.clone();
+    std::thread::spawn(move || {
+        let path = stages.join(format!("stages-{}.jsonl", std::process::id()));
+        let Ok(mut file) = std::fs::File::create(path) else {
+            return;
+        };
+        loop {
+            std::thread::sleep(Duration::from_millis(500));
+            let _ = writeln!(file, "{}", snapshot(origin));
+        }
+    });
+    let start_after = env_secs("ZEROFS_DIAG_PPROF_START");
+    let seconds = env_secs("ZEROFS_DIAG_PPROF_SECS");
+    if seconds == 0 {
+        return;
+    }
+    std::thread::spawn(move || {
+        std::thread::sleep(Duration::from_secs(start_after));
+        let Ok(guard) = pprof::ProfilerGuardBuilder::default()
+            .frequency(499)
+            .blocklist(&["libc", "libgcc", "pthread", "vdso"])
+            .build()
+        else {
+            return;
+        };
+        std::thread::sleep(Duration::from_secs(seconds));
+        let Ok(report) = guard.report().build() else {
+            return;
+        };
+        let path = dir.join(format!("pprof-{}.folded", std::process::id()));
+        let Ok(mut file) = std::fs::File::create(path) else {
+            return;
+        };
+        for (frames, count) in &report.data {
+            let mut stack: Vec<String> = Vec::new();
+            for frame in frames.frames.iter().rev() {
+                for symbol in frame.iter().rev() {
+                    stack.push(symbol.name().replace(';', ":"));
+                }
+            }
+            let thread = frames.thread_name.trim_end_matches(|c: char| c.is_ascii_digit() || c == '-').to_owned();
+            let _ = writeln!(file, "{thread};{} {count}", stack.join(";"));
+        }
+    });
+}
+
+fn env_secs(name: &str) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0)
+}
