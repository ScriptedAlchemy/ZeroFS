Requires=mnt-zerofs\x2dfiles\x2draw-.nbd.mount
After=mnt-zerofs\x2dfiles\x2draw-.nbd.mount
Before=mnt-zerofs\x2dfiles.mount

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/zerofs-normalize-shared-namespace
