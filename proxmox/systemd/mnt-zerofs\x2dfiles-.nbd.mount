[Unit]
Description=Protect live ZeroFS NBD lane files from file-namespace writes
Requires=mnt-zerofs\x2dfiles.mount
After=mnt-zerofs\x2dfiles.mount

[Mount]
What=/mnt/zerofs-files/.nbd
Where=/mnt/zerofs-files/.nbd
Type=none
Options=bind,ro,nosuid,nodev,noexec,_netdev
TimeoutSec=30s

[Install]
WantedBy=remote-fs.target
