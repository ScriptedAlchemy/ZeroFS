[Unit]
Description=ZeroFS file namespace from the private production LXC
After=network-online.target
Wants=network-online.target

[Mount]
What=10.10.10.55:/
Where=/mnt/zerofs-files
Type=nfs
Options=rw,noatime,hard,vers=3,proto=tcp,nolock,port=2049,mountport=2049,rsize=1048576,wsize=1048576,actimeo=1,_netdev
TimeoutSec=120s

[Install]
WantedBy=remote-fs.target
