[cache]
dir = "/srv/zerofs-persist/cache"
disk_size_gb = 128.0
memory_size_gb = 16.0

[storage]
url = "file:///srv/zerofs-persist/backend-dev"

[filesystem]
max_size_gb = 5000.0
ignore_fsync = false

[writeback]
enabled = true
ack_mode = "memory"
memory_size_gb = 4.0
disk_size_gb = 64.0
min_free_gb = 32.0
dir = "/srv/zerofs-persist/state/writeback"

[servers.nbd]
addresses = ["10.10.10.20:10809"]
write_ack_mode = "volatile_memory"
volatile_memory_gb = 16.0

[servers.rpc]
unix_socket = "/run/zerofs/rpc.sock"

[prometheus]
addresses = ["10.10.10.20:9567"]
