# Managed by the ZeroFS Proxmox monitoring bundle.
global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["127.0.0.1:9090"]
  - job_name: "zerofs-prod"
    metrics_path: "/metrics"
    scheme: "http"
    static_configs:
      - targets: ["@@ZEROFS_IP@@:9567"]
        labels:
          service: "zerofs"
          role: "prod"
